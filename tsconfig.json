{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Internal imports carry explicit .ts extensions so the same modules run
    // unbuilt under `node scripts/*.ts` (Node strips types but will not guess
    // extensions) as well as through Metro.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Edge Functions are Deno, not React Native: they resolve `Deno.serve` and
  // JSR/npm specifiers this compiler knows nothing about. They are typechecked
  // by `supabase functions deploy`, which runs the Deno toolchain.
  "exclude": [
    "supabase/functions"
  ]
}
